# REQUIRED: SEC asks that every data.sec.gov client identify itself.
# Use your real contact email. The app refuses to start EDGAR calls without it.
SEC_CONTACT_EMAIL=

# OPTIONAL: leave unset to use the built-in extractive summarizer (no key needed).
LLM_API_KEY=

# OPTIONAL: daily digest email delivery. If unset, digest is saved as HTML only.
DIGEST_TO_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
